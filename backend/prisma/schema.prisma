generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Round {
  id          Int      @id @default(autoincrement())
  description String
  imageUrl    String
  maskUrl     String
  trueColor   String
  createdAt   DateTime @default(now())
}
